# Base de données — rôle et base dédiés sur le PostgreSQL du serveur
DATABASE_URL=postgresql+asyncpg://ninetoone:CHANGE_ME@localhost:5432/ninetoone

# development | production
ENVIRONMENT=production

# Origines autorisées : l'adresse publique du site
CORS_ORIGINS=["https://9to1.matthieuguiot.dev"]

# Obligatoire, au moins 32 caractères aléatoires. L'API refuse de démarrer sinon :
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Bot Difficile : temps de réflexion par coup (secondes) et réflexions simultanées.
# Chaque réflexion occupe un cœur à plein pendant ce temps. Sur un petit serveur (2 vCPU,
# 4 Go) : 0.5 s et 1 thread ; sur une machine confortable : 0.8 s et 2 threads.
BOT_TIME_BUDGET=0.5
BOT_THREADS=1

# Journal des parties jouées contre les bots (une ligne JSON par manche). Vide = désactivé.
GAMES_LOG_PATH=logs/games.jsonl
