[Unit]
Description=Next.js Nine to One Frontend
After=network.target

[Service]
User=matthieu
Group=www-data
WorkingDirectory=/var/www/9to1/frontend
# `pnpm start` = `next start --port 3003` (package.json)
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
